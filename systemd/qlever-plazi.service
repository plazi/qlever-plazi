[Unit]
Description=Build, check and serve the QLever index of qlever.ld.plazi.org
Documentation=https://github.com/plazi/qlever-plazi
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# install.sh adds RequiresMountsFor= and Environment=QP_ROOT= for the QP_ROOT
# of /etc/qlever-plazi.env in qlever-plazi.service.d/data.conf

[Service]
Type=oneshot
User=qlever-plazi
Group=qlever-plazi
# Host settings: /etc/qlever-plazi.env, read by the script itself (QP_ROOT
# comes from the drop-in above)
# Deploy what was merged to main; a failed pull (e.g. GitHub down) builds with the current code
ExecStartPre=-/usr/bin/git -C /opt/qlever-plazi pull --ff-only --quiet
ExecStart=/opt/qlever-plazi/scripts/qlever-plazi.sh run
TimeoutStartSec=4h
