# Host settings for scripts/qlever-plazi.sh, installed as /etc/qlever-plazi.env.
# KEY=value lines, each key once; quote a value with spaces, and put comments
# on lines of their own. Variables set in the environment win. To check the
# file: scripts/qlever-plazi.sh settings (install.sh does, too).

# Where indexes, the live symlink and the status files live. A build needs
# about 35 GB while it runs, the kept indexes about 4 GB each. After changing
# it, run install.sh again (the unit depends on its mount).
QP_ROOT=/var/lib/qlever-plazi

# Traefik (with its Docker provider) routes to the QLever containers:
# the Docker network it reaches them on, its HTTPS entrypoint and the name of
# its certificate resolver (empty: Traefik's default certificate, which is
# self-signed unless configured otherwise).
QP_NETWORK=traefik
QP_ENTRYPOINT=websecure
QP_CERTRESOLVER=leresolver

# Public host name of the endpoint
QP_HOST=qlever.ld.plazi.org

# Optional, see the top of scripts/qlever-plazi.sh for all settings:
# QP_KEEP=3
# QP_MIN_FREE_GB=50
