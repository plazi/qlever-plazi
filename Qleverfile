# Qleverfile for Plazi, use with https://github.com/ad-freiburg/qlever-control
#
# qlever get-data  # downloads .zip file of size 13 MB, uncompressed to 323 MB
# qlever index     # takes ~10 seconds and ~1 GB RAM (on an AMD Ryzen 9 5900X)
# qlever start     # starts the server (instant)

[data]
NAME              = plazi
BASE_URL          = https://github.com/plazi
TEXT_DESCRIPTION  = All literals, search with FILTER CONTAINS(?var, "...")
FORMAT = nq

[index]
INPUT_FILES     = treatments.nq
CAT_INPUT_FILES = cat ${INPUT_FILES}
SETTINGS_JSON   = { "ascii-prefixes-only": false, "num-triples-per-batch": 100000 }
PARSER_BUFFER_SIZE = 20G
STXXL_MEMORY       = 80G
ULIMIT             = 10000

[server]
PORT               = 7019
ACCESS_TOKEN       = ${data:NAME}_7643543846_77ezBeUmRXhK
MEMORY_FOR_QUERIES = 15G
CACHE_MAX_SIZE     = 20G
TIMEOUT            = 30s

[runtime]
SYSTEM = native
IMAGE  = docker.io/adfreiburg/qlever:latest