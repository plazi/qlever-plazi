# Qleverfile for Plazi, use with https://github.com/ad-freiburg/qlever-control
#
# Input: treatments.nq (N-Quads export of turtle-hook-nq, one named graph per
# treatment) and col.nt (Catalogue of Life, default graph).
#
# The access token for privileged operations is NOT set here: this file ends
# up in a public image. docker-entrypoint.sh generates a random one per start.

[data]
NAME              = plazi
BASE_URL          = https://github.com/plazi
TEXT_DESCRIPTION  = All literals, search with FILTER CONTAINS(?var, "...")
FORMAT = nq

[index]
INPUT_FILES     = treatments.nq col.nt
CAT_INPUT_FILES = cat ${INPUT_FILES}
SETTINGS_JSON   = { "ascii-prefixes-only": false, "num-triples-per-batch": 100000 }
PARSER_BUFFER_SIZE = 20G
STXXL_MEMORY       = 80G
ULIMIT             = 10000

[server]
PORT               = 7019
MEMORY_FOR_QUERIES = 40G
CACHE_MAX_SIZE     = 80G
TIMEOUT            = 120s

[runtime]
SYSTEM = native
IMAGE  = docker.io/adfreiburg/qlever:latest